<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header with Go Back Button, Profile Picture, and Name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <!-- Go Back Button -->
        <ImageView
            android:id="@+id/goBackButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_back_arrow"
            android:contentDescription="Go Back"
            android:layout_marginEnd="12dp"
            app:tint="?attr/colorOnSurface"
            android:clickable="true"
            android:focusable="true" />

        <!-- Profile Image -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp">

            <!-- Group Photo -->
            <ImageView
                android:id="@+id/groupPhotoImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@drawable/circle_background"
                android:clipToOutline="true"
                android:visibility="gone" />

            <!-- Member Grid Container -->
            <FrameLayout
                android:id="@+id/memberImagesContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- First Member Image (Top-Left) -->
                <ImageView
                    android:id="@+id/memberImage1"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="start|top"
                    android:scaleType="centerCrop"
                    android:background="@drawable/circle_background"
                    android:clipToOutline="true" />

                <!-- Second Member Image (Bottom-Right) -->
                <ImageView
                    android:id="@+id/memberImage2"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="end|bottom"
                    android:scaleType="centerCrop"
                    android:background="@drawable/circle_background"
                    android:clipToOutline="true" />

            </FrameLayout>
        </FrameLayout>

        <!-- Name and Info Container -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nameTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Group Name"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Group Info Button -->
        <ImageView
            android:id="@+id/groupInfoButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_info"
            android:contentDescription="Group Info"
            android:layout_marginStart="8dp"
            app:tint="?attr/colorOnSurface"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Search Bar and Add Book Button Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <!-- Search Bar with Material Design -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface">

            <EditText
                android:id="@+id/searchView"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@null"
                android:drawableStart="@drawable/ic_search_book"
                android:drawablePadding="12dp"
                android:hint="Search Books or Notes"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="16sp"
                android:inputType="text"
                android:maxLines="1"
                android:imeOptions="actionSearch"/>

        </com.google.android.material.card.MaterialCardView>

        <!-- Add Book Button with Material Design -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface">

            <ImageView
                android:id="@+id/addBookButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:src="@drawable/ic_add_book"
                android:contentDescription="Add Collaborative Book"
                android:clickable="true"
                android:focusable="true"
                app:tint="?attr/colorOnSurface" />

        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Collaborative Books Section Header -->
    <TextView
        android:id="@+id/booksSectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:text="Books"
        android:textColor="?attr/colorOnSurface"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Collaborative Books RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/collaborativeBooksRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:background="?attr/colorBackground" />

    <!-- Chat Section -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"/>

    <!-- Message Input Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/messageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Type a message"
            android:padding="12dp"
            android:background="?attr/colorSurface"/>

        <ImageButton
            android:id="@+id/sendButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_send"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- Notes Section Header -->

    <!-- Notes RecyclerView -->

    <!-- FrameLayout for BookSelectionFragment (hidden initially) -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</LinearLayout>
