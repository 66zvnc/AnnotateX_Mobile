<resources>
    <!-- Custom PSPDFKit theme -->
    <style name="MyApp_PSPDFKitTheme" parent="PSPDFKit.Theme.Default">
        <!-- Primary colors for the toolbar and highlights -->
        <item name="colorPrimary">@color/light_green2</item>
        <item name="colorPrimaryDark">@color/verdigris</item>
        <item name="colorAccent">@color/dark_pink</item>

        <!-- Main toolbar style for consistent toolbar appearance -->
        <item name="pspdf__mainToolbarStyle">@style/MyApp_MainToolbarStyle</item>

        <!-- Action bar icon style to customize toolbar icons -->
        <item name="pspdf__actionBarIconsStyle">@style/MyApp_ActionBarIconsStyle</item>

        <!-- Custom background color for contextual toolbars (e.g., annotation toolbar) -->
        <item name="pspdf__contextualToolbarStyle">@style/MyApp_ContextualToolbarStyle</item>
    </style>

    <!-- Main toolbar style with refined colors for background and text -->
    <style name="MyApp_MainToolbarStyle">
        <item name="pspdf__backgroundColor">@color/light_green2</item>
        <item name="pspdf__textColor">@color/white</item>
        <item name="pspdf__toolbarTheme">@style/ThemeOverlay.AppCompat.Dark.ActionBar</item>
        <item name="pspdf__toolbarPopupTheme">@style/ThemeOverlay.AppCompat.Light</item>
    </style>

    <!-- Icon style for action bar icons to improve readability and appearance -->
    <style name="MyApp_ActionBarIconsStyle">
        <item name="pspdf__iconsColor">@color/white</item>
        <item name="pspdf__iconsColorActivated">@color/verdigris</item>
    </style>

    <!-- Custom contextual toolbar style -->
    <style name="MyApp_ContextualToolbarStyle">
        <item name="pspdf__backgroundColor">@color/dark_pink</item>
        <item name="pspdf__iconsColor">@color/white</item>
        <item name="pspdf__iconsColorActivated">@color/mindaro</item>
    </style>

    <!-- Style for circular image views -->
    <style name="CircularImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Full screen dialog theme -->
    <style name="FullScreenDialogTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="bottomSheetDialogTheme">@style/AppBottomSheetDialogTheme</item>
    </style>

    <style name="AppBottomSheetDialogTheme" parent="Theme.MaterialComponents.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/AppModalStyle</item>
    </style>

    <style name="AppModalStyle" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="android:background">@drawable/bottom_sheet_background</item>
    </style>

    <style name="SettingsCardStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="CustomSwitchTheme" parent="Theme.AppCompat.Light">
        <item name="colorControlActivated">#DE7773</item>
        <item name="colorSwitchThumbNormal">#FFFFFF</item>
        <item name="android:colorForeground">#99000000</item>
    </style>

    <!-- Genre Chip Style -->
    <style name="GenreChipStyle" parent="Widget.MaterialComponents.Chip.Action">
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipMinHeight">32dp</item>
        <item name="android:textSize">14sp</item>
        <item name="chipStartPadding">12dp</item>
        <item name="chipEndPadding">12dp</item>
        <item name="chipCornerRadius">16dp</item>
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>
</resources>
